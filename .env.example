# KI-OS MCP Server — Beispiel-Env
# Kopiere zu .env und fülle aus.

# ===== Required =====

# Pfad zum Vault (im Container immer /vault, hostseitig dein lokaler Pfad)
VAULT_PATH=/vault

# Bearer-Token für Auth — generiere mit: python -c "import secrets; print(secrets.token_urlsafe(32))"
# LEER lassen = Auth deaktiviert (NUR für lokale Dev!)
MCP_TOKEN=

# ===== Optional: Token-Rotation =====
# Während Token-Rotation: alter Token bleibt parallel gültig.
# Setze über `scripts/rotate_token.py` (nicht manuell).
MCP_TOKEN_LEGACY=

# ===== Optional: Bind =====
MCP_HOST=0.0.0.0
MCP_PORT=5002

# ===== Optional: Allowed Hosts/Origins (DNS-Rebinding-Protection) =====
# Comma-separated. Wenn gesetzt: ueberschreibt die Defaults aus server.py
# (NICHT ergaenzen — gibst du was an, ersetzt es die komplette Liste).
# Defaults decken Production-URLs + localhost + Container-Hostname ab.
# Nur setzen wenn du eigene Domains/Hostnames brauchst.
# Beispiel: MCP_ALLOWED_HOSTS=wiki-mcp.sima.business,localhost,127.0.0.1,localhost:5002,127.0.0.1:5002,ki-os-mcp,ki-os-mcp:5002,my-extra-domain.example
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=

# ===== Optional: Rate-Limiting =====
# Requests/Minute pro Client-IP. 0 = deaktiviert.
MCP_RATE_LIMIT_PER_MIN=60

# ===== Optional: Audit-Log =====
# JSONL-Log aller Tool-Calls + Auth-Events.
# Default /var/log/mcp/audit.log (im Container, mounted nach /opt/mcp-logs/).
MCP_AUDIT_LOG=/var/log/mcp/audit.log

# ===== Optional: Snapshots =====
# Tar.gz vor destruktiven Ops (move, delete, edit_file).
# Default /snapshots (im Container, mounted nach /opt/mcp-snapshots/).
MCP_SNAPSHOT_DIR=/snapshots
MCP_SNAPSHOT_ENABLED=1

# ===== OAuth 2.1 (fuer claude.ai Connectors etc.) =====
# Leer lassen = OAuth deaktiviert, nur Bearer-Token aktiv.
# Wenn alle 3 gesetzt sind: Dual-Auth — JWT bevorzugt, Bearer bleibt parallel.
OAUTH_USER_EMAIL=julius@sima.or.at

# bcrypt-Hash des Passworts. Setze via:
#   docker exec -it ki-os-mcp python /app/scripts/set_oauth_password.py
# WICHTIG: $$-Escape im docker-compose env_file — falls Hash $-Zeichen enthaelt
# muessen die im .env als $$ stehen.
OAUTH_PASSWORD_HASH=

# JWT-Signing-Secret (HS256). Generiere mit:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# AENDERN dreht alle aktiven Sessions. Halte das geheim.
OAUTH_JWT_SECRET=

# Issuer (= deine Domain) und Resource-URL (= /mcp/-Endpoint).
# Werden in Discovery-Doc + JWT-Claims (iss, aud) eingebaut.
OAUTH_ISSUER=https://wiki-mcp.sima.business
OAUTH_RESOURCE=https://wiki-mcp.sima.business/mcp/

# Token-Lifetimes (Sekunden). Defaults: 15min Access, 3 Tage Refresh.
OAUTH_ACCESS_TTL=900
OAUTH_REFRESH_TTL=259200

# SQLite-Pfad fuer OAuth-State (Clients + Refresh-Tokens)
OAUTH_DB_PATH=/var/lib/mcp-oauth/oauth.db
